<UserControl x:Class="StockManager.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StockManager.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel Margin="2,2,6,28">

            <Border Style="{StaticResource CardStyle}" Padding="0">
                <StackPanel>

                    <!-- Ligne d'en-tête -->
                    <Border Style="{StaticResource TableHeaderRowStyle}" CornerRadius="11,11,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="DATE" Style="{StaticResource TableHeaderStyle}" />
                            <TextBlock Grid.Column="1" Text="PRODUIT" Style="{StaticResource TableHeaderStyle}" />
                            <TextBlock Grid.Column="2" Text="TYPE" Style="{StaticResource TableHeaderStyle}" />
                            <TextBlock Grid.Column="3"
                                       Text="QUANTITÉ"
                                       Style="{StaticResource TableHeaderStyle}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Mouvements, du plus récent au plus ancien -->
                    <ItemsControl ItemsSource="{Binding Movements}" Margin="0,0,0,-1">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TableRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding DateText}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ProductName}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,16,0" />

                                        <!-- Entrée / Sortie -->
                                        <Border x:Name="TypeBadge"
                                                Grid.Column="2"
                                                Style="{StaticResource BadgeStyle}"
                                                Background="{StaticResource SuccessSoftBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="TypeIcon"
                                                      Style="{StaticResource IconStyleSmall}"
                                                      Data="{StaticResource IconArrowUp}"
                                                      Stroke="{StaticResource SuccessBrush}"
                                                      VerticalAlignment="Center" />
                                                <TextBlock x:Name="TypeText"
                                                           Text="{Binding TypeText}"
                                                           Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{StaticResource SuccessBrush}"
                                                           Margin="4,0,2,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock x:Name="QuantityText"
                                                   Grid.Column="3"
                                                   Text="{Binding QuantityText}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <!-- Une sortie de stock s'affiche en rouge -->
                                    <DataTrigger Binding="{Binding IsEntree}" Value="False">
                                        <Setter TargetName="TypeBadge" Property="Background"
                                                Value="{StaticResource DangerSoftBrush}" />
                                        <Setter TargetName="TypeIcon" Property="Data"
                                                Value="{StaticResource IconArrowDown}" />
                                        <Setter TargetName="TypeIcon" Property="Stroke"
                                                Value="{StaticResource DangerBrush}" />
                                        <Setter TargetName="TypeText" Property="Foreground"
                                                Value="{StaticResource DangerBrush}" />
                                        <Setter TargetName="QuantityText" Property="Foreground"
                                                Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Historique vide -->
                    <StackPanel Margin="20,46,20,52"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <Path Style="{StaticResource IconStyleLarge}"
                              Data="{StaticResource IconEmpty}"
                              Stroke="{StaticResource TextMutedBrush}"
                              HorizontalAlignment="Center" />
                        <TextBlock Text="Aucun mouvement enregistré"
                                   Style="{StaticResource EmptyStateTitleStyle}" />
                        <TextBlock Text="Les ajouts et les retraits de stock apparaîtront ici, du plus récent au plus ancien."
                                   Style="{StaticResource EmptyStateTextStyle}"
                                   MaxWidth="360" />
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
