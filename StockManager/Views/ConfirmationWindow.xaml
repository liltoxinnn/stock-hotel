<Window x:Class="StockManager.Views.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:StockManager.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ConfirmationViewModel}"
        Title="{Binding Title}"
        Width="430"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True">

    <StackPanel>

        <!-- Message -->
        <Border Padding="24,24,24,22">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="IconBadge"
                        Width="44" Height="44" CornerRadius="11"
                        Background="{StaticResource DangerSoftBrush}"
                        VerticalAlignment="Top">
                    <Path x:Name="IconPath"
                          Style="{StaticResource IconStyleMedium}"
                          Data="{StaticResource IconAlert}"
                          Stroke="{StaticResource DangerBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" Width="306">
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource DialogTitleStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Message}"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Boutons -->
        <Border Background="{StaticResource HoverBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="Annuler"
                        MinWidth="110"
                        IsCancel="True"
                        Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisibility}}" />
                <Button x:Name="ConfirmButton"
                        Style="{StaticResource DangerButtonStyle}"
                        Content="{Binding ConfirmLabel}"
                        MinWidth="110"
                        Margin="10,0,0,0"
                        IsDefault="True"
                        Command="{Binding ConfirmCommand}" />
            </StackPanel>
        </Border>

    </StackPanel>
</Window>
