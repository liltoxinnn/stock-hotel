<Window x:Class="StockManager.Views.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:StockManager.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AddProductViewModel}"
        Title="Ajouter un produit"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">

    <StackPanel>

        <!-- En-tête -->
        <Border Padding="24,22,24,20">
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="11"
                        Background="{StaticResource PrimarySoftBrush}"
                        VerticalAlignment="Top">
                    <Path Style="{StaticResource IconStyleMedium}"
                          Data="{StaticResource IconPackage}"
                          Stroke="{StaticResource PrimaryBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Ajouter un produit" Style="{StaticResource DialogTitleStyle}" />
                    <TextBlock Text="Nouvelle référence dans l'inventaire"
                               Style="{StaticResource HeaderSubtitleStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Height="1" Background="{StaticResource DividerBrush}" />

        <!-- Corps -->
        <StackPanel Margin="24,20,24,22">

            <TextBlock Text="Nom du produit" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:Name="NameBox"
                     Style="{StaticResource AppTextBoxStyle}"
                     Tag="Par exemple : Drap de bain"
                     MaxLength="120"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Quantité initiale"
                       Style="{StaticResource FieldLabelStyle}"
                       Margin="0,18,0,7" />
            <TextBox x:Name="QuantityBox"
                     Style="{StaticResource AppTextBoxStyle}"
                     MaxLength="9"
                     Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Message d'erreur -->
            <Border Style="{StaticResource ErrorBannerStyle}"
                    Margin="0,14,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconStyleSmall}"
                          Data="{StaticResource IconAlert}"
                          Stroke="{StaticResource DangerBrush}"
                          VerticalAlignment="Top" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource ErrorTextStyle}"
                               Margin="8,0,0,0"
                               MaxWidth="330" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Boutons -->
        <Border Background="{StaticResource HoverBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="Annuler"
                        MinWidth="110"
                        IsCancel="True" />
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Content="Ajouter"
                        MinWidth="110"
                        Margin="10,0,0,0"
                        IsDefault="True"
                        Command="{Binding ConfirmCommand}" />
            </StackPanel>
        </Border>

    </StackPanel>
</Window>
