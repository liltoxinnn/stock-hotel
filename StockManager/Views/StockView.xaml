<UserControl x:Class="StockManager.Views.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StockManager.ViewModels"
             xmlns:behaviors="clr-namespace:StockManager.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StockViewModel}">

    <!-- PanningMode : défilement en faisant glisser le doigt sur l'écran -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly"
                  PanningDeceleration="0.001"
                  Focusable="False">
        <StackPanel Margin="2,2,6,28">

            <!-- ==================== Indicateurs ==================== -->
            <UniformGrid Columns="3" Margin="0,0,0,20">

                <!-- Nombre de produits -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Nombre de produits" Style="{StaticResource CardLabelStyle}" />
                            <TextBlock Text="{Binding ProductCount}" Style="{StaticResource CardValueStyle}" />
                            <TextBlock Text="références dans l'inventaire" Style="{StaticResource CardCaptionStyle}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Style="{StaticResource IconBadgeStyle}"
                                Background="{StaticResource PrimarySoftBrush}">
                            <Path Style="{StaticResource IconStyleMedium}"
                                  Data="{StaticResource IconPackage}"
                                  Stroke="{StaticResource PrimaryBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Total des articles en stock -->
                <Border Style="{StaticResource CardStyle}" Margin="8,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Total des articles en stock" Style="{StaticResource CardLabelStyle}" />
                            <TextBlock Text="{Binding TotalQuantity}" Style="{StaticResource CardValueStyle}" />
                            <TextBlock Text="articles toutes références confondues" Style="{StaticResource CardCaptionStyle}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Style="{StaticResource IconBadgeStyle}"
                                Background="{StaticResource SuccessSoftBrush}">
                            <Path Style="{StaticResource IconStyleMedium}"
                                  Data="{StaticResource IconLayers}"
                                  Stroke="{StaticResource SuccessBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Produits avec stock faible -->
                <Border Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Produits avec stock faible" Style="{StaticResource CardLabelStyle}" />
                            <TextBlock Text="{Binding LowStockCount}" Style="{StaticResource CardValueStyle}" />
                            <TextBlock Text="{Binding LowStockCaption}" Style="{StaticResource CardCaptionStyle}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Style="{StaticResource IconBadgeStyle}"
                                Background="{StaticResource WarningSoftBrush}">
                            <Path Style="{StaticResource IconStyleMedium}"
                                  Data="{StaticResource IconAlert}"
                                  Stroke="{StaticResource WarningBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- =============== Recherche et ajout de produit =============== -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid HorizontalAlignment="Left" Width="420">
                    <TextBox Style="{StaticResource AppTextBoxStyle}"
                             Tag="Rechercher un produit..."
                             Padding="46,0,48,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Path Style="{StaticResource IconStyleSmall}"
                          Data="{StaticResource IconSearch}"
                          Stroke="{StaticResource TextMutedBrush}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Margin="13,0,0,0" />
                    <Button Style="{StaticResource GhostIconButtonStyle}"
                            Width="38" Height="38"
                            HorizontalAlignment="Right"
                            Margin="0,0,5,0"
                            ToolTip="Effacer la recherche"
                            Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibility}}">
                        <Path Style="{StaticResource IconStyleSmall}"
                              Data="{StaticResource IconClose}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>

                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AddProductCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconStyleSmall}"
                              Data="{StaticResource IconPlus}"
                              Stroke="White"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Ajouter un produit" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ==================== Tableau des produits ==================== -->
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <StackPanel>

                    <!-- Ligne d'en-tête -->
                    <Border Style="{StaticResource TableHeaderRowStyle}" CornerRadius="11,11,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="PRODUIT" Style="{StaticResource TableHeaderStyle}" />
                            <TextBlock Grid.Column="1"
                                       Text="STOCK"
                                       Style="{StaticResource TableHeaderStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="ACTIONS"
                                       Style="{StaticResource TableHeaderStyle}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Lignes -->
                    <ItemsControl ItemsSource="{Binding Products}" Margin="0,0,0,-1">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TableRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Nom du produit -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Style="{StaticResource BadgeStyle}"
                                                    Background="{StaticResource WarningSoftBrush}"
                                                    Margin="10,0,0,0"
                                                    Visibility="{Binding IsLowStock, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Stock faible"
                                                           Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{StaticResource WarningBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource BadgeStyle}"
                                                    Background="{StaticResource DangerSoftBrush}"
                                                    Margin="10,0,0,0"
                                                    Visibility="{Binding IsOutOfStock, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Rupture de stock"
                                                           Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{StaticResource DangerBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Quantité : − / nombre / + -->
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">

                                            <Button Style="{StaticResource RemoveStockButtonStyle}"
                                                    ToolTip="Retirer une unité"
                                                    Command="{Binding DataContext.DecrementCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Path Style="{StaticResource IconStyleSmall}"
                                                      Data="{StaticResource IconMinus}"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Button>

                                            <!-- Double-clic : saisie de la quantité au clavier -->
                                            <Grid Width="72"
                                                  Height="46"
                                                  Margin="8,0"
                                                  Background="Transparent"
                                                  Cursor="Hand"
                                                  Stylus.IsPressAndHoldEnabled="False"
                                                  ToolTip="Double-cliquez (ou double-tapez) pour saisir la quantité">
                                                <Grid.InputBindings>
                                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                                  Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}" />
                                                </Grid.InputBindings>

                                                <TextBlock x:Name="QuantityText"
                                                           Text="{Binding PendingQuantity}"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}" />

                                                <TextBox Style="{StaticResource AppTextBoxStyle}"
                                                         Height="46"
                                                         FontSize="15"
                                                         FontWeight="Bold"
                                                         Padding="4,0"
                                                         TextAlignment="Center"
                                                         MaxLength="7"
                                                         behaviors:NumericInput.DigitsOnly="True"
                                                         behaviors:FocusAttachment.IsFocused="{Binding IsEditing}"
                                                         Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                         LostFocus="QuantityEditor_LostFocus"
                                                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Enter"
                                                                    Command="{Binding DataContext.CommitEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" />
                                                        <KeyBinding Key="Escape"
                                                                    Command="{Binding DataContext.CancelChangeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" />
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                            </Grid>

                                            <Button Style="{StaticResource AddStockButtonStyle}"
                                                    ToolTip="Ajouter une unité"
                                                    Command="{Binding DataContext.IncrementCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Path Style="{StaticResource IconStyleSmall}"
                                                      Data="{StaticResource IconPlus}"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Button>
                                        </StackPanel>

                                        <!-- Actions : modifier / supprimer, ou valider l'ajustement -->
                                        <Grid Grid.Column="2">

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding HasNoPendingChange, Converter={StaticResource BoolToVisibility}}">
                                                <Button Style="{StaticResource GhostIconButtonStyle}"
                                                        ToolTip="Modifier le produit"
                                                        Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Style="{StaticResource IconStyleSmall}"
                                                          Data="{StaticResource IconEdit}"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                                <Button Style="{StaticResource GhostDangerIconButtonStyle}"
                                                        Margin="4,0,0,0"
                                                        ToolTip="Supprimer le produit"
                                                        Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Style="{StaticResource IconStyleSmall}"
                                                          Data="{StaticResource IconDelete}"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding HasPendingChange, Converter={StaticResource BoolToVisibility}}">
                                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                                        Height="46"
                                                        Padding="14,0"
                                                        FontSize="12.5"
                                                        ToolTip="Enregistrer ce mouvement de stock"
                                                        Command="{Binding DataContext.ConfirmChangeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Style="{StaticResource IconStyleSmall}"
                                                              Data="{StaticResource IconCheck}"
                                                              Stroke="White"
                                                              VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ConfirmLabel}"
                                                                   Margin="7,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostIconButtonStyle}"
                                                        Margin="6,0,0,0"
                                                        ToolTip="Annuler l'ajustement"
                                                        Command="{Binding DataContext.CancelChangeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Style="{StaticResource IconStyleSmall}"
                                                          Data="{StaticResource IconClose}"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                        <Setter TargetName="QuantityText" Property="Foreground"
                                                Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                        <Setter TargetName="QuantityText" Property="Foreground"
                                                Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                    <!-- Ajustement non enregistré : le nombre passe en bleu -->
                                    <DataTrigger Binding="{Binding HasPendingChange}" Value="True">
                                        <Setter TargetName="QuantityText" Property="Foreground"
                                                Value="{StaticResource PrimaryBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Inventaire vide -->
                    <StackPanel Margin="20,46,20,52"
                                Visibility="{Binding IsInventoryEmpty, Converter={StaticResource BoolToVisibility}}">
                        <Path Style="{StaticResource IconStyleLarge}"
                              Data="{StaticResource IconPackage}"
                              Stroke="{StaticResource TextMutedBrush}"
                              HorizontalAlignment="Center" />
                        <TextBlock Text="Aucun produit dans l'inventaire"
                                   Style="{StaticResource EmptyStateTitleStyle}" />
                        <TextBlock Text="Ajoutez votre premier produit pour commencer à suivre votre stock."
                                   Style="{StaticResource EmptyStateTextStyle}"
                                   MaxWidth="340" />
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Center"
                                Margin="0,18,0,0"
                                Command="{Binding AddProductCommand}"
                                Content="Ajouter un produit" />
                    </StackPanel>

                    <!-- Aucun résultat de recherche -->
                    <StackPanel Margin="20,46,20,52"
                                Visibility="{Binding HasNoSearchResults, Converter={StaticResource BoolToVisibility}}">
                        <Path Style="{StaticResource IconStyleLarge}"
                              Data="{StaticResource IconSearch}"
                              Stroke="{StaticResource TextMutedBrush}"
                              HorizontalAlignment="Center" />
                        <TextBlock Text="Aucun produit trouvé"
                                   Style="{StaticResource EmptyStateTitleStyle}" />
                        <TextBlock Text="Aucun produit ne correspond à votre recherche."
                                   Style="{StaticResource EmptyStateTextStyle}"
                                   MaxWidth="340" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Center"
                                Margin="0,18,0,0"
                                Command="{Binding ClearSearchCommand}"
                                Content="Effacer la recherche" />
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
