<UserControl x:Class="StockManager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StockManager.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel Margin="2,2,6,28" MaxWidth="620" HorizontalAlignment="Left">

            <!-- ================= Seuil de stock faible ================= -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Seuil de stock faible" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Un produit est signalé comme « stock faible » lorsque sa quantité est inférieure ou égale à ce seuil."
                               Style="{StaticResource CardCaptionStyle}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />

                    <TextBlock Text="Seuil" Style="{StaticResource FieldLabelStyle}" Margin="0,18,0,7" />

                    <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Width="120"
                                 Style="{StaticResource AppTextBoxStyle}"
                                 Tag="2"
                                 Text="{Binding LowStockThresholdText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="10,0,0,0"
                                Command="{Binding SaveCommand}"
                                Content="Enregistrer" />
                    </Grid>

                    <!-- Message d'erreur -->
                    <Border Style="{StaticResource ErrorBannerStyle}"
                            Margin="0,16,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorTextStyle}" />
                    </Border>

                    <!-- Message de confirmation -->
                    <Border Style="{StaticResource SuccessBannerStyle}"
                            Margin="0,16,0,0"
                            Visibility="{Binding HasConfirmation, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconStyleSmall}"
                                  Data="{StaticResource IconCheck}"
                                  Stroke="{StaticResource SuccessBrush}"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConfirmationMessage}"
                                       Style="{StaticResource SuccessTextStyle}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- =============== Emplacement des données =============== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Enregistrement des données" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Toutes les modifications sont enregistrées immédiatement dans une base de données locale. L'application fonctionne entièrement hors connexion."
                               Style="{StaticResource CardCaptionStyle}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />

                    <TextBlock Text="Fichier de la base de données"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,18,0,7" />

                    <Border Background="{StaticResource BackgroundBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="13,11">
                        <TextBlock Text="{Binding DatabaseFile}"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
