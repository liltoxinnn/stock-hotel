<Window x:Class="StockManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StockManager.ViewModels"
        xmlns:views="clr-namespace:StockManager.Views"
        Title="Gestion de stock"
        Height="770" Width="1180"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Chaque page est associée à son ViewModel -->
        <DataTemplate DataType="{x:Type vm:StockViewModel}">
            <views:StockView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ====================== Barre latérale ====================== -->
        <Border Background="{StaticResource SidebarBrush}">
            <DockPanel>

                <!-- Identité de l'application -->
                <Border DockPanel.Dock="Top" Padding="22,26,22,22">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="11"
                                Background="{StaticResource PrimaryBrush}">
                            <Path Style="{StaticResource IconStyleMedium}"
                                  Data="{StaticResource IconPackage}"
                                  Stroke="White"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Gestion de stock"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SidebarTextActiveBrush}" />
                            <TextBlock Text="Inventaire"
                                       FontSize="11"
                                       Margin="0,1,0,0"
                                       Foreground="{StaticResource SidebarTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Mention de bas de page -->
                <Border DockPanel.Dock="Bottom" Padding="24,16,24,22">
                    <StackPanel>
                        <Border Height="1" Background="{StaticResource SidebarSeparatorBrush}" Margin="0,0,0,14" />
                        <TextBlock Text="Enregistrement automatique"
                                   FontSize="11"
                                   Foreground="{StaticResource SidebarTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Fonctionne hors connexion"
                                   FontSize="11"
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource SidebarTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <StackPanel>
                    <TextBlock Text="NAVIGATION"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Margin="24,4,24,10"
                               Foreground="{StaticResource SidebarTextBrush}" />

                    <RadioButton Style="{StaticResource NavItemStyle}"
                                 GroupName="Navigation"
                                 IsChecked="{Binding IsStockActive, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="stock">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconStyleMedium}"
                                  Data="{StaticResource IconPackage}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Stock" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItemStyle}"
                                 GroupName="Navigation"
                                 IsChecked="{Binding IsHistoryActive, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="history">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconStyleMedium}"
                                  Data="{StaticResource IconHistory}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Historique" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItemStyle}"
                                 GroupName="Navigation"
                                 IsChecked="{Binding IsSettingsActive, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="settings">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconStyleMedium}"
                                  Data="{StaticResource IconSettings}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Paramètres" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ======================= Zone principale ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <Border Padding="32,28,32,20">
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource HeaderTitleStyle}" />
                    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource HeaderSubtitleStyle}" />
                </StackPanel>
            </Border>

            <!-- Page courante -->
            <ContentControl Grid.Row="1"
                            Margin="32,0,26,0"
                            Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
