<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Pictogrammes vectoriels dessinés sur une grille de 24 x 24.
        Ils sont tracés au trait (Stroke) : voir le style « IconStyle ».
    -->

    <!-- Carton / produit -->
    <PathGeometry x:Key="IconPackage"
                  Figures="M21,16 L21,8 L12,3 L3,8 L3,16 L12,21 Z
                           M3.3,7 L12,12 L20.7,7
                           M12,21.6 L12,12" />

    <!-- Piles d'articles -->
    <PathGeometry x:Key="IconLayers"
                  Figures="M12,2.5 L2.5,7 L12,11.5 L21.5,7 Z
                           M2.5,16.5 L12,21 L21.5,16.5
                           M2.5,11.75 L12,16.25 L21.5,11.75" />

    <!-- Alerte : stock faible -->
    <PathGeometry x:Key="IconAlert"
                  Figures="M10.3,3.9 L1.8,18 A2,2 0 0,0 3.5,21 L20.5,21 A2,2 0 0,0 22.2,18 L13.7,3.9 A2,2 0 0,0 10.3,3.9 Z
                           M12,9 L12,13.5
                           M12,16.8 L12.01,16.8" />

    <!-- Horloge : historique -->
    <PathGeometry x:Key="IconHistory"
                  Figures="M2,12 A10,10 0 1,0 22,12 A10,10 0 1,0 2,12 Z
                           M12,6.5 L12,12 L15.8,14" />

    <!-- Réglages -->
    <PathGeometry x:Key="IconSettings"
                  Figures="M5,21 L5,14  M5,10 L5,3
                           M12,21 L12,12  M12,8 L12,3
                           M19,21 L19,16  M19,12 L19,3
                           M2,12 L8,12
                           M9,10 L15,10
                           M16,14 L22,14" />

    <!-- Loupe : recherche -->
    <PathGeometry x:Key="IconSearch"
                  Figures="M4,11 A7,7 0 1,0 18,11 A7,7 0 1,0 4,11 Z
                           M16,16 L21,21" />

    <!-- Plus : ajouter au stock -->
    <PathGeometry x:Key="IconPlus"
                  Figures="M12,5 L12,19  M5,12 L19,12" />

    <!-- Moins : retirer du stock -->
    <PathGeometry x:Key="IconMinus"
                  Figures="M5,12 L19,12" />

    <!-- Crayon : modifier -->
    <PathGeometry x:Key="IconEdit"
                  Figures="M11,4 L4,4 A2,2 0 0,0 2,6 L2,20 A2,2 0 0,0 4,22 L18,22 A2,2 0 0,0 20,20 L20,13
                           M18.4,2.6 A2.1,2.1 0 0,1 21.4,5.6 L12,15 L8,16 L9,12 Z" />

    <!-- Corbeille : supprimer -->
    <PathGeometry x:Key="IconDelete"
                  Figures="M3,6 L21,6
                           M19,6 L19,20 A2,2 0 0,1 17,22 L7,22 A2,2 0 0,1 5,20 L5,6
                           M8,6 L8,4 A2,2 0 0,1 10,2 L14,2 A2,2 0 0,1 16,4 L16,6
                           M10,11 L10,17
                           M14,11 L14,17" />

    <!-- Croix : effacer la recherche / fermer -->
    <PathGeometry x:Key="IconClose"
                  Figures="M18,6 L6,18  M6,6 L18,18" />

    <!-- Flèche vers le bas : sortie de stock -->
    <PathGeometry x:Key="IconArrowDown"
                  Figures="M12,5 L12,19  M6,13 L12,19 L18,13" />

    <!-- Flèche vers le haut : entrée de stock -->
    <PathGeometry x:Key="IconArrowUp"
                  Figures="M12,19 L12,5  M6,11 L12,5 L18,11" />

    <!-- Coche : confirmation -->
    <PathGeometry x:Key="IconCheck"
                  Figures="M4,12.5 L9.5,18 L20,6.5" />

    <!-- Document vide : aucun élément -->
    <PathGeometry x:Key="IconEmpty"
                  Figures="M14,2 L6,2 A2,2 0 0,0 4,4 L4,20 A2,2 0 0,0 6,22 L18,22 A2,2 0 0,0 20,20 L20,8 Z
                           M14,2 L14,8 L20,8
                           M8,13 L16,13
                           M8,17 L13,17" />

    <!-- Passer en plein ecran -->
    <PathGeometry x:Key="IconFullscreen"
                  Figures="M9,3 L3,3 L3,9
                           M15,3 L21,3 L21,9
                           M21,15 L21,21 L15,21
                           M3,15 L3,21 L9,21" />

    <!-- Quitter le plein ecran -->
    <PathGeometry x:Key="IconExitFullscreen"
                  Figures="M3,9 L9,9 L9,3
                           M21,9 L15,9 L15,3
                           M15,21 L15,15 L21,15
                           M9,21 L9,15 L3,15" />

</ResourceDictionary>
