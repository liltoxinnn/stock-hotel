<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================ Couleurs ============================ -->

    <!-- Fonds -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F8FAFC" />

    <!-- Barre latérale -->
    <SolidColorBrush x:Key="SidebarBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="SidebarTextActiveBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarSeparatorBrush" Color="#1E293B" />

    <!-- Couleur principale -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#EFF6FF" />

    <!-- Entrées de stock -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#DCFCE7" />
    <SolidColorBrush x:Key="SuccessSoftHoverBrush" Color="#BBF7D0" />

    <!-- Sorties de stock et actions destructrices -->
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEE2E2" />
    <SolidColorBrush x:Key="DangerSoftHoverBrush" Color="#FECACA" />

    <!-- Stock faible -->
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FEF3C7" />

    <!-- Textes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />

    <!-- Bordures et séparateurs -->
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="DividerBrush" Color="#EEF2F7" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#94A3B8" />

    <!-- ========================= Formes et mesures ====================== -->

    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">999</CornerRadius>

    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>

</ResourceDictionary>
