<Application x:Class="StockManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:StockManager.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Palette.xaml" />
                <ResourceDictionary Source="Resources/Styles/Icons.xaml" />
                <ResourceDictionary Source="Resources/Styles/Controls.xaml" />
                <ResourceDictionary Source="Resources/Styles/ScrollBars.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Convertisseurs partagés -->
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BooleanToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
